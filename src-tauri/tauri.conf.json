{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnagCraft",
  "version": "1.5.6",
  "identifier": "cc.rostad.snagcraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnagCraft",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/snagcraft.desktop.template"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "category": "Utility",
    "shortDescription": "Screen capture and annotation",
    "longDescription": "Open-source Snagit-style screen capture, annotation and recording.",
    "fileAssociations": [
      { "ext": ["png"], "mimeType": "image/png", "role": "Editor", "description": "PNG image" },
      { "ext": ["jpg", "jpeg"], "mimeType": "image/jpeg", "role": "Editor", "description": "JPEG image" },
      { "ext": ["webp"], "mimeType": "image/webp", "role": "Editor", "description": "WebP image" },
      { "ext": ["gif"], "mimeType": "image/gif", "role": "Editor", "description": "GIF image" },
      { "ext": ["bmp"], "mimeType": "image/bmp", "role": "Editor", "description": "Bitmap image" },
      { "ext": ["avif"], "mimeType": "image/avif", "role": "Editor", "description": "AVIF image" },
      { "ext": ["tif", "tiff"], "mimeType": "image/tiff", "role": "Editor", "description": "TIFF image" }
    ]
  }
}